<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Inertia macro helpers -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}" />
      <inertia ixx="${(2/5) * mass * (radius*radius)}" ixy="0.0" ixz="0.0"
               iyy="${(2/5) * mass * (radius*radius)}" iyz="0.0"
               izz="${(2/5) * mass * (radius*radius)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}" />
      <inertia ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
               izz="${(1/12) * mass * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}" />
      <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
               izz="${(1/2) * mass * (radius*radius)}" />
    </inertial>
  </xacro:macro>

  <!-- Materials -->
  <material name="chassis_blue">
    <color rgba="0.12 0.45 0.78 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="sensor_orange">
    <color rgba="0.95 0.45 0.1 1.0"/>
  </material>

  <material name="caster_metal">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- BASE FOOTPRINT -->
  <link name="base_footprint"/>

  <!-- BASE LINK -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.36 0.14"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.36 0.14"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="12.0" x="0.48" y="0.36" z="0.14">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.12 0.45 0.78 1.0</ambient>
        <diffuse>0.12 0.45 0.78 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- LEFT WHEEL -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.21 0.02" rpy="-${pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.045"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.10" length="0.045"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="1.5" length="0.045" radius="0.10">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="left_wheel">
    <visual>
      <material>
        <ambient>0.15 0.15 0.15 1.0</ambient>
        <diffuse>0.15 0.15 0.15 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- RIGHT WHEEL -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.21 0.02" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.10" length="0.045"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.10" length="0.045"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="1.5" length="0.045" radius="0.10">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="right_wheel">
    <visual>
      <material>
        <ambient>0.15 0.15 0.15 1.0</ambient>
        <diffuse>0.15 0.15 0.15 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- FRONT CASTER WHEEL -->
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.18 0 -0.03"/>
  </joint>

  <link name="front_caster">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="caster_metal"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.5" radius="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <gazebo reference="front_caster">
    <visual>
      <material>
        <ambient>0.6 0.6 0.6 1.0</ambient>
        <diffuse>0.6 0.6 0.6 1.0</diffuse>
      </material>
    </visual>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- REAR CASTER WHEEL -->
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.18 0 -0.03"/>
  </joint>

  <link name="rear_caster">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="caster_metal"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.5" radius="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <gazebo reference="rear_caster">
    <visual>
      <material>
        <ambient>0.6 0.6 0.6 1.0</ambient>
        <diffuse>0.6 0.6 0.6 1.0</diffuse>
      </material>
    </visual>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

</robot>
