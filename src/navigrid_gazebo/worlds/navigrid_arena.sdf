<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="navigrid_arena">

    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -1.0</direction>
    </light>

    <!-- Ambient / Fill Light -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 -0.2 -1.0</direction>
    </light>

    <!-- Ground Plane (30m x 30m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.37 1.0</ambient>
            <diffuse>0.5 0.5 0.53 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena Boundary Walls (30m x 30m footprint, height 2.5m, solid lidar-reflective) -->
    <model name="boundary_walls">
      <static>true</static>
      <!-- North Wall (+Y) -->
      <link name="north_wall">
        <pose>0 15.0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>30.4 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.4 0.4 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.75 1.0</ambient>
            <diffuse>0.7 0.7 0.75 1.0</diffuse>
          </material>
        </visual>
      </link>
      <!-- South Wall (-Y) -->
      <link name="south_wall">
        <pose>0 -15.0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>30.4 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.4 0.4 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.75 1.0</ambient>
            <diffuse>0.7 0.7 0.75 1.0</diffuse>
          </material>
        </visual>
      </link>
      <!-- East Wall (+X) -->
      <link name="east_wall">
        <pose>15.0 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.4 30.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 30.0 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.75 1.0</ambient>
            <diffuse>0.7 0.7 0.75 1.0</diffuse>
          </material>
        </visual>
      </link>
      <!-- West Wall (-X) -->
      <link name="west_wall">
        <pose>-15.0 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.4 30.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 30.0 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.75 1.0</ambient>
            <diffuse>0.7 0.7 0.75 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start Zone A (Green Pad) -->
    <model name="start_zone_a">
      <static>true</static>
      <pose>-11.0 0.0 0.005 0 0 0</pose>
      <link name="pad">
        <visual name="visual">
          <geometry><box><size>2.5 2.5 0.01</size></box></geometry>
          <material>
            <ambient>0.1 0.75 0.25 1.0</ambient>
            <diffuse>0.1 0.85 0.25 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Goal Zone B (Blue/Gold Pad) -->
    <model name="goal_zone_b">
      <static>true</static>
      <pose>11.0 0.0 0.005 0 0 0</pose>
      <link name="pad">
        <visual name="visual">
          <geometry><box><size>2.5 2.5 0.01</size></box></geometry>
          <material>
            <ambient>0.15 0.45 0.95 1.0</ambient>
            <diffuse>0.2 0.55 1.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Direct Incline Ramp Structure (Connecting A to B on Euclidean Line along y=0) -->
    <model name="direct_incline_ramp">
      <static>true</static>
      <!-- Incline Ramp Up (x from -6 to -2, rise = 1.0m, pitch = -14.04 deg / -0.245 rad) -->
      <link name="ramp_up">
        <pose>-4.0 0 0.50 0 -0.244978 0</pose>
        <collision name="collision">
          <geometry><box><size>4.123 2.0 0.08</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.123 2.0 0.08</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1.0</ambient>
            <diffuse>0.7 0.45 0.25 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- Ramp Up Guardrails -->
      <link name="ramp_up_rail_left">
        <pose>-4.0 1.0 0.65 0 -0.244978 0</pose>
        <collision name="col"><geometry><box><size>4.123 0.08 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.123 0.08 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1.0</ambient><diffuse>0.9 0.9 0.2 1.0</diffuse></material>
        </visual>
      </link>
      <link name="ramp_up_rail_right">
        <pose>-4.0 -1.0 0.65 0 -0.244978 0</pose>
        <collision name="col"><geometry><box><size>4.123 0.08 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.123 0.08 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1.0</ambient><diffuse>0.9 0.9 0.2 1.0</diffuse></material>
        </visual>
      </link>

      <!-- Elevated Bridge Platform Deck (x from -2 to +2 at z = 1.0m) -->
      <link name="bridge_deck">
        <pose>0.0 0 0.96 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>4.0 2.0 0.08</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 2.0 0.08</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.2 1.0</ambient>
            <diffuse>0.6 0.4 0.25 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- Bridge Deck Support Pillars -->
      <link name="bridge_pillar_1">
        <pose>-1.5 0.8 0.46 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.92</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.92</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="bridge_pillar_2">
        <pose>-1.5 -0.8 0.46 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.92</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.92</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="bridge_pillar_3">
        <pose>1.5 0.8 0.46 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.92</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.92</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="bridge_pillar_4">
        <pose>1.5 -0.8 0.46 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.92</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.92</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>

      <!-- Bridge Guardrails -->
      <link name="bridge_rail_left">
        <pose>0.0 1.0 1.12 0 0 0</pose>
        <collision name="col"><geometry><box><size>4.0 0.08 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.0 0.08 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1.0</ambient><diffuse>0.9 0.9 0.2 1.0</diffuse></material>
        </visual>
      </link>
      <link name="bridge_rail_right">
        <pose>0.0 -1.0 1.12 0 0 0</pose>
        <collision name="col"><geometry><box><size>4.0 0.08 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.0 0.08 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1.0</ambient><diffuse>0.9 0.9 0.2 1.0</diffuse></material>
        </visual>
      </link>

      <!-- Incline Ramp Down (x from +2 to +6, descends from z = 1.0m to 0m, pitch = +14.04 deg / +0.245 rad) -->
      <link name="ramp_down">
        <pose>4.0 0 0.50 0 0.244978 0</pose>
        <collision name="collision">
          <geometry><box><size>4.123 2.0 0.08</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.123 2.0 0.08</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1.0</ambient>
            <diffuse>0.7 0.45 0.25 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- Ramp Down Guardrails -->
      <link name="ramp_down_rail_left">
        <pose>4.0 1.0 0.65 0 0.244978 0</pose>
        <collision name="col"><geometry><box><size>4.123 0.08 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.123 0.08 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1.0</ambient><diffuse>0.9 0.9 0.2 1.0</diffuse></material>
        </visual>
      </link>
      <link name="ramp_down_rail_right">
        <pose>4.0 -1.0 0.65 0 0.244978 0</pose>
        <collision name="col"><geometry><box><size>4.123 0.08 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.123 0.08 0.25</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1.0</ambient><diffuse>0.9 0.9 0.2 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Central Route Separator Walls (Separates direct ramp corridor from zig-zag corridors) -->
    <model name="route_separators">
      <static>true</static>
      <!-- South separator wall along Y = -1.8 -->
      <link name="sep_south">
        <pose>0.0 -2.0 1.0 0 0 0</pose>
        <collision name="col"><geometry><box><size>13.0 0.3 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>13.0 0.3 2.0</size></box></geometry>
          <material><ambient>0.4 0.45 0.5 1.0</ambient><diffuse>0.5 0.55 0.6 1.0</diffuse></material>
        </visual>
      </link>
      <!-- North boundary partition wall along Y = +2.0 -->
      <link name="sep_north">
        <pose>0.0 2.0 1.0 0 0 0</pose>
        <collision name="col"><geometry><box><size>13.0 0.3 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>13.0 0.3 2.0</size></box></geometry>
          <material><ambient>0.4 0.45 0.5 1.0</ambient><diffuse>0.5 0.55 0.6 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Racks & Zig-Zag Path Corridors (Static Obstacles) -->
    <model name="warehouse_racks">
      <static>true</static>

      <!-- Rack Row 1 (at Y = -6.0) -->
      <link name="rack_1">
        <pose>-6.0 -5.5 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>4.0 0.8 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.0 0.8 2.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1.0</ambient><diffuse>0.25 0.35 0.7 1.0</diffuse></material>
        </visual>
      </link>

      <!-- Rack Row 2 (at Y = -5.5) -->
      <link name="rack_2">
        <pose>2.0 -5.5 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.0 0.8 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.0 0.8 2.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1.0</ambient><diffuse>0.25 0.35 0.7 1.0</diffuse></material>
        </visual>
      </link>

      <!-- Rack Row 3: Creates the Narrow Chokepoint Corridor (Corridor width = 1.3m at Y = -9.5) -->
      <link name="rack_choke_left">
        <pose>-3.5 -9.5 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.0 0.8 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.0 0.8 2.2</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1.0</ambient><diffuse>0.9 0.35 0.1 1.0</diffuse></material>
        </visual>
      </link>

      <link name="rack_choke_right">
        <pose>-3.5 -12.1 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.0 0.8 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.0 0.8 2.2</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1.0</ambient><diffuse>0.9 0.35 0.1 1.0</diffuse></material>
        </visual>
      </link>

      <!-- Rack Row 4: East return corridor -->
      <link name="rack_4">
        <pose>6.5 -9.5 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>4.5 0.8 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.5 0.8 2.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1.0</ambient><diffuse>0.25 0.35 0.7 1.0</diffuse></material>
        </visual>
      </link>

      <!-- North Side Storage Racks (Balancing World Complexity) -->
      <link name="rack_north_1">
        <pose>-6.0 6.0 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.0 0.8 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.0 0.8 2.2</size></box></geometry>
          <material><ambient>0.3 0.5 0.3 1.0</ambient><diffuse>0.35 0.6 0.35 1.0</diffuse></material>
        </visual>
      </link>

      <link name="rack_north_2">
        <pose>2.0 6.0 1.1 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.0 0.8 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.0 0.8 2.2</size></box></geometry>
          <material><ambient>0.3 0.5 0.3 1.0</ambient><diffuse>0.35 0.6 0.35 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Structural Pillars (Cylinders) -->
    <model name="structural_pillars">
      <static>true</static>
      <link name="pillar_1">
        <pose>-9.0 -4.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.35</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.35</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_2">
        <pose>-0.5 -7.5 1.25 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.35</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.35</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_3">
        <pose>9.0 -4.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.35</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.35</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_4">
        <pose>0.0 10.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.35</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.35</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Animated Dynamic Agent 1: Pedestrian Crossing West Path Entrance -->
    <actor name="pedestrian_west">
      <link name="actor_body">
        <collision name="col">
          <geometry><cylinder><radius>0.28</radius><length>1.75</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.28</radius><length>1.75</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1.0</ambient>
            <diffuse>0.9 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0.0</time><pose>-7.5 -3.0 0.88 0 0 1.57</pose></waypoint>
          <waypoint><time>5.0</time><pose>-7.5 1.5 0.88 0 0 1.57</pose></waypoint>
          <waypoint><time>10.0</time><pose>-7.5 -3.0 0.88 0 0 -1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Animated Dynamic Agent 2: Pedestrian Crossing East Path Exit -->
    <actor name="pedestrian_east">
      <link name="actor_body">
        <collision name="col">
          <geometry><cylinder><radius>0.28</radius><length>1.75</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.28</radius><length>1.75</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.1 0.8 1.0</ambient>
            <diffuse>0.9 0.1 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0.0</time><pose>7.5 1.5 0.88 0 0 -1.57</pose></waypoint>
          <waypoint><time>5.0</time><pose>7.5 -3.0 0.88 0 0 -1.57</pose></waypoint>
          <waypoint><time>10.0</time><pose>7.5 1.5 0.88 0 0 1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Secondary AMR: Dynamic Mobile Robot Moving Perpendicular Across Zig-Zag Route -->
    <model name="secondary_amr">
      <pose>1.0 -7.5 0.15 0 0 1.57</pose>
      <link name="chassis">
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.2</ixx><iyy>0.2</iyy><izz>0.3</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.6 0.45 0.22</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.45 0.22</size></box></geometry>
          <material>
            <ambient>0.9 0.6 0.0 1.0</ambient>
            <diffuse>0.95 0.65 0.05 1.0</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.25 -0.05 -1.570796 0 0</pose>
        <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <collision name="col"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="right_wheel">
        <pose>0 -0.25 -0.05 1.570796 0 0</pose>
        <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <collision name="col"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child><axis><xyz>0 0 -1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="caster">
        <pose>0.2 0 -0.1 0 0 0</pose>
        <collision name="col"><geometry><sphere><radius>0.05</radius></sphere></geometry></collision>
        <visual name="vis"><geometry><sphere><radius>0.05</radius></sphere></geometry></visual>
      </link>
      <joint name="caster_joint" type="fixed"><parent>chassis</parent><child>caster</child></joint>

      <!-- Secondary AMR DiffDrive Controller -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.5</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>/secondary_amr/cmd_vel</topic>
        <odom_topic>/secondary_amr/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>secondary_amr/base_link</child_frame_id>
      </plugin>
    </model>

  </world>
</sdf>
